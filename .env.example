OPENAI_API_KEY=your_openai_api_key_here
PORT=3001
NODE_ENV=development

# Security: API key for /api/refresh endpoint (optional in dev, recommended in prod)
REFRESH_API_KEY=your_secret_refresh_key_here

# Security: Comma-separated list of allowed CORS origins (required in production)
# In development, localhost origins are allowed by default
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
